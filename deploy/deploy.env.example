# Sao chép thành deploy/deploy.env (không đưa vào Git) rồi sửa cho máy chủ của bạn.
# Tên máy trong ~/.ssh/config (máy chủ cần Docker + quyền chạy docker)
DEPLOY_HOST=my-server
# Địa chỉ công khai của máy chủ ReaChat (dùng để kiểm tra sau triển khai)
DEPLOY_URL=https://chat.example.com
# Thư mục trên máy chủ (chứa .env, data/)
DEPLOY_DIR=/opt/reachat
