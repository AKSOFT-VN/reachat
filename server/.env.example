# ReaChat server configuration — copy to .env and adjust. Full reference: docs/CONFIGURATION.md
# Lines starting with # are comments. Everything except PUBLIC_URL is optional.

# Public address of your server (used for Google sign-in and links)
PUBLIC_URL=https://chat.example.com

# The container port is published on 127.0.0.1 only and reached through your reverse proxy
# -> trust the proxy's client-IP headers (needed for per-IP limits).
TRUST_PROXY=all
# Header carrying the client IP: x-forwarded-for (last entry, default) for nginx / Caddy; behind Cloudflare:
# IP_HEADER=cf-connecting-ip

# Per-user storage quota (MB). Recommended for servers open to public registration.
# USER_QUOTA_MB=2048

# Session signing key. Leave unset to auto-generate one (stored next to the database).
# JWT_SECRET=

# Shown in the terms / privacy pages (server/legal/). Have them reviewed for your jurisdiction.
OPERATOR_NAME=Example Ltd.
OPERATOR_CONTACT=admin@example.com

# Web Push contact
VAPID_SUBJECT=mailto:admin@example.com

# ---- Calls ----------------------------------------------------------------
# Built-in TURN: open UDP 3478 and 49160-49200 on every firewall.
# TURN_EXTERNAL_IP=203.0.113.10
# TURN_PUBLIC_HOST=203.0.113.10
# Or Cloudflare TURN (works through most firewalls; free tier 1,000 GB/month):
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# TURN_MONTHLY_GB=900

# ---- Email / SMS (verification codes, password reset, alerts) -------------
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=ReaChat <no-reply@example.com>
# SMS_HTTP_URL=https://sms.example.com/send?to={to}&text={text}

# ---- Google sign-in -------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Alerts ---------------------------------------------------------------
# ALERT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...
# ALERT_EMAIL=ops@example.com
